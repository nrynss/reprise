# The plan travels with the code. AGENTS.md, product.md and dev-diary/ are
# tracked, so a clone carries how the work runs, what the product is, and every
# phase. The gate's name and plan-reference scans skip them by path, because a
# phase file naming a task is the point of a phase file.

# Secrets never land here.
.env
.env.*
!.env.example

# Editor swap and backup files. A swap file mirrors the contents of the file it
# belongs to, so an unignored one beside .env carries the secrets past the rules
# above: ..env.kate-swp is matched by none of them.
*~
*.kate-swp
.*.kate-swp
.*.sw[a-p]
*.sw[a-p]

# Dependency and build output.
node_modules/
web/build/
web/.svelte-kit/
.vite/
*.tsbuildinfo

# Test artifacts.
web/test-results/
web/playwright-report/
web/blob-report/
web/.cache/
