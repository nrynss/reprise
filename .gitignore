# Planning stays out of the repository.
AGENTS.md
product.md
dev-diary/*
# The mockup is the exception: it is committed so it travels between machines.
# A parent directory cannot be un-ignored, hence dev-diary/* rather than dev-diary/.
!dev-diary/mockup/

# Secrets never land here.
.env
.env.*
!.env.example

# Dependency and build output.
node_modules/
web/build/
web/.svelte-kit/
.vite/
*.tsbuildinfo

# Test artifacts.
web/test-results/
web/playwright-report/
web/blob-report/
web/.cache/
