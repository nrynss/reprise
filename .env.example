# Copy this file to .env and fill each value. Never commit the result.
# The Vertex AI service account key is a file, not a variable. Its path is in
# the settings file, and the key never belongs here.
# GOOGLE_CLIENT_SECRET may stay empty until Google sign-in is configured.
# The entry must stay present, because the settings file reads it at boot.
ASSEMBLYAI_API_KEY=
SESSION_SIGNING_KEY=
RESEND_API_KEY=
GOOGLE_CLIENT_SECRET=
LOGIN_CODE_KEY=
